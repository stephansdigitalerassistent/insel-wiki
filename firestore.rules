rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    match /registration_requests/{tokenId} {
      // Allow the backend bot (identified by email) full access
      allow read, write, update, delete: if request.auth != null && 
        (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
         request.auth.token.email == 'stephansdigitalassistent@gmail.com');

      // Allow frontend to create requests (must be @insel.ch)
      allow create: if request.resource.data.email.matches('.*@insel[.]ch$');
      
      // Allow public to read/delete (needed for the frontend "waiting" state)
      allow read, delete: if true;
    }

    match /archive/{pageId} {
      // Backend bot has full access to manage the archive
      allow read, write, delete: if request.auth != null && 
        (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
         request.auth.token.email == 'stephansdigitalassistent@gmail.com');
      
      // Other authenticated users can read/write if they belong to @insel.ch
      allow read, write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
      
      // Allow recursive access to history subcollection
      match /history/{snapshotId} {
        allow read, write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
        allow write, delete: if request.auth != null && request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com';
      }

      // Allow recursive access to comments subcollection
      match /comments/{commentId} {
        allow read, write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
      }
    }

    match /pages/{pageId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
      allow delete: if request.auth != null && 
        (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
         request.auth.token.email == 'stephansdigitalassistent@gmail.com' ||
         request.auth.token.email == 'test.user@insel.ch');
      
      match /history/{historyId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
        allow delete: if request.auth != null && 
          (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
           request.auth.token.email == 'stephansdigitalassistent@gmail.com' ||
           request.auth.token.email == 'test.user@insel.ch');
      }

      match /presence/{sessionId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
        allow delete: if request.auth != null && 
          (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
           request.auth.token.email == 'stephansdigitalassistent@gmail.com' ||
           request.auth.token.email == 'test.user@insel.ch');
      }

      match /yjs_updates/{updateId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
        allow delete: if request.auth != null && 
          (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
           request.auth.token.email == 'stephansdigitalassistent@gmail.com' ||
           request.auth.token.email == 'test.user@insel.ch');
      }

      match /yjs_awareness/{clientId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
        allow delete: if request.auth != null && 
          (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
           request.auth.token.email == 'stephansdigitalassistent@gmail.com' ||
           request.auth.token.email == 'test.user@insel.ch');
      }

      match /yjs_state/{stateId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
        allow delete: if request.auth != null && 
          (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
           request.auth.token.email == 'stephansdigitalassistent@gmail.com' ||
           request.auth.token.email == 'test.user@insel.ch');
      }

      match /comments/{commentId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
        allow delete: if request.auth != null && 
          (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
           request.auth.token.email == 'stephansdigitalassistent@gmail.com' ||
           request.auth.token.email == 'test.user@insel.ch');
      }
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
