rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isBot() {
      return request.auth != null && 
        (request.auth.token.email == 'stephansdigitalassistent+wiki@gmail.com' || 
         request.auth.token.email == 'stephansdigitalassistent@gmail.com');
    }

    function isInsel() {
      return request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
    }

    function isPageAccessible(resourceData) {
      return isBot() || (
        isInsel() && 
        resourceData != null &&
        'allowedEmails' in resourceData && 
        resourceData.allowedEmails != null && 
        resourceData.allowedEmails.hasAny(['*', request.auth.token.email])
      );
    }

    function getPageData(pageId) {
      return get(/databases/$(database)/documents/pages/$(pageId)).data;
    }

    function canAccessPage(pageId) {
      return isBot() || (isInsel() && isPageAccessible(getPageData(pageId)));
    }

    match /registration_requests/{tokenId} {
      // Only the backend bot has access (registration data no longer stored here)
      allow read, write, delete: if isBot();
    }

    match /archive/{pageId} {
      // Backend bot has full access to manage the archive
      allow read, write, delete: if isBot();
      
      // Other authenticated users can read/write if they belong to @insel.ch
      allow read, write: if isInsel();
      
      // Allow recursive access to history subcollection
      match /history/{snapshotId} {
        allow read, write: if isInsel();
        allow write, delete: if isBot();
      }

      // Allow recursive access to comments subcollection
      match /comments/{commentId} {
        allow read, write: if isInsel();
      }
    }

    match /pages/{pageId} {
      allow read: if isBot() || (isInsel() && (resource == null || isPageAccessible(resource.data)));
      // Writes must come from an @insel.ch user, AND if the document carries
      // a `lastSavedBy` field it must equal the authenticated email — so it
      // cannot be spoofed to impersonate an admin and trigger the DevOps bot.
      allow write: if isInsel() && (resource == null || isPageAccessible(resource.data))
        && 'allowedEmails' in request.resource.data
        && request.resource.data.allowedEmails is list
        && request.resource.data.allowedEmails.size() > 0
        && (resource == null ?
            (!('lastSavedBy' in request.resource.data) || request.resource.data.lastSavedBy == request.auth.token.email) :
            (!(request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSavedBy'])) || request.resource.data.lastSavedBy == request.auth.token.email)
           );
      allow delete: if (isInsel() && isPageAccessible(resource.data)) || isBot();
      
      match /history/{historyId} {
        allow read: if canAccessPage(pageId);
        allow write: if canAccessPage(pageId) && isInsel();
        allow delete: if canAccessPage(pageId) && (isInsel() || isBot());
      }

      match /yjs_updates/{updateId} {
        allow read: if canAccessPage(pageId);
        allow write: if canAccessPage(pageId) && isInsel();
        allow delete: if canAccessPage(pageId) && (isInsel() || isBot());
      }

      match /yjs_awareness/{clientId} {
        allow read: if canAccessPage(pageId);
        allow write: if canAccessPage(pageId) && isInsel();
        allow delete: if canAccessPage(pageId) && (isInsel() || isBot());
      }

      match /yjs_state/{stateId} {
        allow read: if canAccessPage(pageId);
        allow write: if canAccessPage(pageId) && isInsel();
        allow delete: if canAccessPage(pageId) && (isInsel() || isBot());
      }

      match /comments/{commentId} {
        allow read: if canAccessPage(pageId);
        allow write: if canAccessPage(pageId) && isInsel();
        allow delete: if canAccessPage(pageId) && (isInsel() || isBot());
      }
    }

    match /users/{userId} {
      allow read: if isInsel() || isBot();
      allow write: if request.auth != null && (
        isBot() || 
        (request.auth.uid == userId 
         && request.resource.data.email == request.auth.token.email
         && (resource == null ? 
             request.resource.data.isActive == false : 
             (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['isActive']) || request.resource.data.isActive == resource.data.isActive)
            )
        )
      );
    }

    // Validate the shape and bound the size of a client error report so the
    // open create endpoint can't be used to write arbitrary or oversized docs.
    function isValidClientError() {
      let d = request.resource.data;
      return d.keys().hasOnly([
          'message', 'stack', 'severity', 'source', 'url', 'userAgent',
          'userId', 'userName', 'appVersion', 'breadcrumbs', 'online',
          'viewport', 'timestamp'
        ])
        && d.message is string && d.message.size() > 0 && d.message.size() <= 4000
        && d.severity in ['error', 'warning', 'unhandled-rejection', 'uncaught']
        && (!('stack' in d) || d.stack == null || (d.stack is string && d.stack.size() <= 16000))
        && (!('source' in d) || d.source == null || (d.source is string && d.source.size() <= 200))
        && (!('url' in d) || (d.url is string && d.url.size() <= 4000 && d.url.matches('^https?://(localhost|127\\.0\\.0\\.1|insel-wiki\\.web\\.app|insel-wiki\\.firebaseapp\\.com).*$')))
        && (!('userAgent' in d) || (d.userAgent is string && d.userAgent.size() <= 2000))
        && (!('appVersion' in d) || (d.appVersion is string && d.appVersion.size() <= 200))
        && (!('breadcrumbs' in d) || (d.breadcrumbs is list && d.breadcrumbs.size() <= 50))
        && (!('online' in d) || d.online is bool)
        && (!('viewport' in d) || (d.viewport is string && d.viewport.size() <= 50))
        && d.timestamp == request.time;
    }

    match /client_errors/{errorId} {
      allow create: if isValidClientError();
      allow read, update, delete: if isBot();
    }
  }
}
