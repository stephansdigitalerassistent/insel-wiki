rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // General read access for all wiki media
    match /{allPaths=**} {
      allow read: if true;
    }

    // Rules for user avatars
    match /avatars/{userId}/{fileName} {
      // User can only write (upload/delete) their own avatar
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for editor image uploads
    match /editor/{userId}/{fileName} {
      // Users must be from @insel.ch to upload images to the wiki
      allow write: if request.auth != null && request.auth.token.email.matches('.*@insel[.]ch$');
    }
  }
}
