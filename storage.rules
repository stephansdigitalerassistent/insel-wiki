rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Read access for authenticated users only (was public; clinical media
    // must not be world-readable).
    match /{allPaths=**} {
      allow read: if request.auth != null;
    }

    // Rules for user avatars
    match /avatars/{userId}/{fileName} {
      // User can only write (upload/delete) their own avatar; cap size and
      // require an image content-type to prevent abuse/arbitrary uploads.
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Rules for editor image uploads
    match /editor/{userId}/{fileName} {
      // Users must be from @insel.ch to upload images to the wiki; cap size and
      // require an image content-type.
      allow write: if request.auth != null
        && request.auth.token.email.matches('.*@insel[.]ch$')
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
